includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app

    # Level 6 is the project baseline — see https://phpstan.org/user-guide/rule-levels
    level: 6

    tmpDir: storage/framework/cache/phpstan

    # Larastan bootstrap
    bootstrapFiles:
        - vendor/larastan/larastan/bootstrap.php

    # Ignore legacy/third-party noise; new code must be clean at level 6.
    ignoreErrors:

    # Baseline for pre-existing issues — regenerate with:
    #   vendor/bin/phpstan analyse --generate-baseline
    # Zero new errors are allowed beyond this baseline.
    # baseline: phpstan-baseline.neon