parameters:
	ignoreErrors:
		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 1
			path: app/Console/Commands/ManageSkills.php

		-
			message: '#^Offset ''command'' on array\{triggers\: array\<string, mixed\>, dependencies\: array\<int, string\>, enabled\: bool, command\: string, id\: string, name\: string, description\: string, input\: array\<string, mixed\>, \.\.\.\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: app/Console/Commands/ManageSkills.php

		-
			message: '#^Method App\\Services\\SkillExecutor\:\:__construct\(\) has parameter \$config with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/SkillExecutor.php

		-
			message: '#^Method App\\Services\\SkillExecutor\:\:loadConfig\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/SkillExecutor.php

		-
			message: '#^Method App\\Services\\SkillExecutor\:\:runCommand\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/SkillExecutor.php

		-
			message: '#^PHPDoc tag @param references unknown parameter\: \$params$#'
			identifier: parameter.notFound
			count: 1
			path: app/Services/SkillExecutor.php

		-
			message: '#^Property App\\Services\\SkillExecutor\:\:\$config type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/SkillExecutor.php

		-
			message: '#^Property App\\Services\\SkillExecutor\:\:\$executionLog type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/SkillExecutor.php

		-
			message: '#^Method App\\Services\\SkillRegistry\:\:get\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/SkillRegistry.php

		-
			message: '#^Offset ''enabled'' on array\{triggers\: array\<string, mixed\>, dependencies\: array\<int, string\>, enabled\: bool, command\: string, id\: string, name\: string, description\: string, input\: array\<string, mixed\>, \.\.\.\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: app/Services/SkillRegistry.php

		-
			message: '#^Property App\\Services\\SkillRegistry\:\:\$config is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: app/Services/SkillRegistry.php

		-
			message: '#^Property App\\Services\\SkillRegistry\:\:\$config type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: app/Services/SkillRegistry.php
